# ── AkenZ MD configuration ────────────────────────────────────────────
# Copy to .env and fill in.  .env is gitignored — never commit it.

# Bot identity
BOT_NAME=AkenZ MD
BOT_VERSION=1.0.0

# Owner-only. Digits only, country code first, no '+' and no spaces.
# Sri Lanka example: 947XXXXXXXX
OWNER_NUMBER=

# The WhatsApp address of the person who may run owner commands. Private chats
# are addressed by LID these days, not by phone number, so without this the real
# owner is denied in 1:1 chats. Message the bot ".profile" to read your own
# address, then paste it here. Examples:
#   123456789012345@lid      94771234567@s.whatsapp.net
OWNER_JID=

# Command prefix. One of: . ! / #
BOT_PREFIX=.

# Default language: en | si
BOT_LANGUAGE=en

# Timezone for the scheduler
TIMEZONE=Asia/Colombo

# ── Database (SQLite for personal deployment) ───────────────────────────
# Relative paths resolve against prisma/, so ../data lands in <project>/data.
DATABASE_URL=file:../data/noaura.db

# ── WhatsApp session ────────────────────────────────────────────────────
# Directory where the encrypted credential store lives. Never served publicly.
SESSION_DIR=./data/session

# 32-byte key as 64 hex characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key = you must pair again. Changing it invalidates the session.
SESSION_ENCRYPTION_KEY=

# ── Private dashboard ───────────────────────────────────────────────────
DASHBOARD_PORT=3000
# Only ever reachable by you. Bind to 127.0.0.1 unless you are behind a VPN.
DASHBOARD_HOST=127.0.0.1
# Bootstrap password. Hashed on first boot and stored in the database;
# change it afterwards from the dashboard (DASHBOARD_PASSWORD is then ignored).
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=

# Secret used to sign the session cookie. Any long random string.
COOKIE_SECRET=

# ── Optional integrations (bot degrades gracefully when empty) ──────────
# AI: gemini | openai | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_SYSTEM_PROMPT=You are AkenZ MD. Answer in the language the user wrote in.
AI_MAX_CHARS=1800
AI_HISTORY_LIMIT=12

# Weather: open-meteo (no key required) | openweathermap
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Translator: mymemory (no key required) | deepl
TRANSLATE_PROVIDER=mymemory
TRANSLATE_API_KEY=

# ── Media tools ─────────────────────────────────────────────────────────
MEDIA_ENABLED=true
# Absolute paths if the tools are not on PATH.
YTDLP_PATH=
FFMPEG_PATH=
MEDIA_MAX_MB=40
MEDIA_TIMEOUT_MS=120000
MEDIA_RATE_LIMIT_PER_HOUR=6

# ── Group features ──────────────────────────────────────────────────────
WELCOME=true
GOODBYE=true
MAX_WARNINGS=3
# mute | remove
WARNING_ACTION=mute

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Multi-bot (one process, many buyer bots) ────────────────────────────
# Key the shop server uses to create/remove buyer bots via POST /api/instances.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to keep the provisioning routes closed.
PROVISION_API_KEY=

# ── Order alerts ────────────────────────────────────────────────────────
# Shared key the storefront sends as x-notify-key on POST /api/notify. The route
# texts the owner's WhatsApp on every new order. Leave empty to keep it closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFY_API_KEY=
